{
  "openapi": "3.0.3",
  "info": {
    "title": "Jobmesh — Job Postings API",
    "version": "1.0.0",
    "description": "A live, de-duplicated index of open job postings aggregated from dozens of applicant-tracking systems and job boards into one searchable API. Every role links back to its original application page. Keyless to try; a Premium plan lifts the per-request result cap and the rate limit.\n\n- **Search** `/jobs` with keyword + filters (country, platform, level, remote, salary, recency), paginated.\n- **De-duplication**: the same role posted on several sources collapses to one result (`group_size`, `other_source_urls`).\n- **Freshness**: `/changes` streams new, updated and closed postings since a cursor.\n- **Coverage**: `/sources` reports the per-platform status of all 78 required platforms.\n\nFree plan: up to 50 results/request, 240 requests/minute. Premium plan: up to 1000 results/request, 2,400 requests/minute, full exports.\n\nOnly public postings via official APIs and feeds — robots.txt honoured, no scraping.",
    "contact": {
      "name": "Jobmesh",
      "url": "https://jobmesh.world/api"
    }
  },
  "paths": {
    "/stats": {
      "get": {
        "summary": "Get Stats",
        "description": "Headline numbers about the current index. A browser (Accept: text/html)\ngets the human status page; API clients get JSON.",
        "operationId": "get_stats_stats_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/coverage": {
      "get": {
